---
import '../styles/global.css';
import { products, copy, site } from '../lib/data.js';
import { makeT } from '../lib/logic.js';
// overlay: 첫 화면 배너 위 투명 헤더 / bare: 쇼핑몰 헤더·하단 없는 별도 화면(관리자) / top: 맨 위로 버튼
const { title = 'KQ MD SHOP', overlay = false, bare = false, top = false, extra = {} } = Astro.props;
const T = makeT(copy);
const data = JSON.stringify({ products, copy, site, ...extra }).replace(/</g, '\\u003c');
const cols = [
  ['f.support', [['f.notice', '/help/#notice'], ['f.faq', '/help/#faq'], ['f.inquiry', '/help/#inquiry'], ['f.cs', '/help/#cs']]],
  ['f.guide', [['f.shipping', '/help/#shipping'], ['f.exchange', '/help/#exchange'], ['f.address', '/help/#address'], ['f.track', '/login/'], ['f.retailers', '/retailers/']]],
  ['f.policy', [['f.terms', '/help/#terms'], ['f.privacy', '/help/#privacy'], ['f.youth', '/help/#youth'], ['f.cookie', '/help/#cookie']]],
];
const ic = 'w-6 h-6 fill-none stroke-current';
const intl = T('region.intl').replaceAll('$XX', `$${site.shipping_from_usd}`);
---
<!doctype html>
<html lang="ko" data-region="KR" data-country="KR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>{title}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <script is:inline>
      (function () {
        var h = document.documentElement, g = function (k) { try { return localStorage.getItem(k); } catch (e) { return null; } };
        var tz = ''; try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
        var map = { 'Asia/Seoul': 'KR', 'Asia/Tokyo': 'JP', 'Asia/Shanghai': 'CN', 'Europe/London': 'GB', 'Europe/Berlin': 'DE', 'Europe/Paris': 'FR', 'Europe/Madrid': 'ES', 'America/Mexico_City': 'MX' };
        var c = g('kq_country') || map[tz] || (tz.indexOf('America/') === 0 ? 'US' : tz.indexOf('Australia/') === 0 ? 'AU' : 'KR');
        var l = g('kq_lang') || ((navigator.language || 'ko').indexOf('ko') === 0 ? 'ko' : 'en');
        h.lang = l; h.dataset.country = c; h.dataset.region = c === 'KR' ? 'KR' : 'INTL';
      })();
    </script>
  </head>
  <body class="font-sans antialiased">
    {!bare && (
      <header id="hdr" class:list={['fixed inset-x-0 top-0 z-40', !overlay && 'is-solid']} data-overlay={overlay ? '1' : undefined}>
        <div class="wrap flex h-14 items-center gap-3 sm:gap-4">
          <a href="/" class="text-xl font-black tracking-tight">KQ<span class="hidden sm:inline"> SHOP</span></a>
          <div class="relative">
            <button type="button" data-open="dd-artists" class="whitespace-nowrap text-sm font-bold"><Fragment set:html={T('nav.artists')} /> ▾</button>
            <div id="dd-artists" class="dd hidden absolute left-0 top-full mt-2 w-48 rounded-lg border border-neutral-200 bg-white p-2 shadow-xl">
              {site.artists.map((a) => a.active
                ? <a href={`/artist/${a.id}/`} class="block rounded px-3 py-2 font-bold hover:bg-neutral-100">{a.name}</a>
                : <span class="block cursor-default select-none px-3 py-2 text-neutral-400">{a.name} <Fragment set:html={T('region.demo')} /></span>)}
            </div>
          </div>
          <nav class="ml-auto flex items-center gap-3">
            <!-- 국가·언어·통화: 헤더 고정 버튼 -->
            <div class="relative">
              <button type="button" data-open="region" class="flex items-center gap-1 text-[13px] font-bold" aria-label="Country and language">
                <svg class="h-5 w-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.6"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18" /></svg><span data-cc>KR</span>
              </button>
              <div id="region" class="dd hidden absolute right-0 top-full mt-2 w-[min(88vw,380px)] rounded-lg border border-neutral-200 bg-white p-4 text-[13px] shadow-xl">
                <p class="font-bold"><Fragment set:html={T('region.shipto')} /> <span data-country-name></span> · <span data-lang-name></span> · <span data-cur></span></p>
                <p class="intl mt-1 text-xs text-neutral-600" set:html={intl} />
                <div class="mt-3 grid grid-cols-2 gap-4 border-t border-neutral-200 pt-3">
                  <div>
                    <p class="mb-1 text-xs text-neutral-500" set:html={T('region.country')} />
                    {site.countries.map((c) => <button type="button" data-set-country={c.code} class="block w-full py-1.5 text-left"><span class="ko">{c.ko}</span><span class="en">{c.en}</span></button>)}
                  </div>
                  <div>
                    <p class="mb-1 text-xs text-neutral-500" set:html={T('region.lang')} />
                    <button type="button" data-set-lang="ko" class="block w-full py-1.5 text-left">한국어</button>
                    <button type="button" data-set-lang="en" class="block w-full py-1.5 text-left">English</button>
                    {['日本語', '中文', 'Español'].map((l) => <span class="block cursor-default select-none py-1.5 text-neutral-400">{l} <Fragment set:html={T('region.demo')} /></span>)}
                  </div>
                </div>
              </div>
            </div>
            <a href="/login/" aria-label="My orders"><svg class={ic} viewBox="0 0 24 24" stroke-width="1.6"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" /></svg></a>
            <button type="button" data-act="cartview" class="relative" aria-label="Cart">
              <svg class={ic} viewBox="0 0 24 24" stroke-width="1.6"><path d="M5 8h14l-1.2 12H6.2L5 8z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" /></svg>
              <span data-cart class="hidden absolute -right-2 -top-1 min-w-[18px] rounded-full bg-rose-600 px-1 text-center text-[11px] font-bold leading-[18px] text-white">0</span>
            </button>
          </nav>
        </div>
      </header>
    )}

    <main class:list={[!overlay && !bare && 'pt-14']}>
      <slot />
    </main>

    {!bare && (
      <footer class="mt-14 border-t border-neutral-200 bg-neutral-50 text-[13px] text-neutral-600">
        <div class="wrap grid gap-x-8 py-8 md:grid-cols-4">
          {cols.map(([h, links]) => (
            <details open class="border-b border-neutral-200 py-3 md:border-0 md:py-0">
              <summary class="list-none font-bold text-neutral-900 md:pointer-events-none" set:html={T(h)} />
              <ul class="mt-3 space-y-2">{links.map(([k, href]) => <li><a class="hover:underline" href={href} set:html={T(k)} /></li>)}</ul>
            </details>
          ))}
          <details open class="py-3 md:py-0">
            <summary class="list-none font-bold text-neutral-900 md:pointer-events-none" set:html={T('f.biz')} />
            <p class="mt-3 leading-relaxed" set:html={T('f.bizinfo')} />
            <p class="mt-2" set:html={T('d.cs')} />
          </details>
        </div>
        <div class="wrap flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-neutral-200 py-5 text-xs">
          <span class="rounded border border-neutral-400 px-2 py-1 font-bold text-neutral-700" set:html={T('f.badge')} />
          <a class="underline" href="/scenario/" set:html={T('nav.scenario')} />
          <span set:html={T('f.credit')} />
          <p class="w-full text-neutral-500" set:html={T('footer.notice')} />
        </div>
      </footer>
    )}

    {top && <button type="button" id="totop" data-act="top" aria-label="Back to top" class="pointer-events-none fixed bottom-5 right-4 z-30 flex h-11 w-11 items-center justify-center rounded-full border border-neutral-300 bg-white text-lg opacity-0 shadow-lg transition-opacity md:right-8">↑</button>}
    <div id="toast" role="status" class="pointer-events-none fixed inset-x-4 bottom-24 z-[60] mx-auto max-w-md rounded-lg bg-neutral-900 px-4 py-3 text-center text-sm text-white opacity-0 shadow-xl transition-opacity"></div>
    <script type="application/json" id="__data" set:html={data}></script>
    <script>import '../lib/app.js';</script>
  </body>
</html>
