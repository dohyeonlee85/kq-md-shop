---
import 'swiper/css';
import 'swiper/css/pagination';
import Base from '../layouts/Base.astro';
import Poster from '../components/Poster.astro';
import { products, copy, site, img } from '../lib/data.js';
import { makeT, sortProducts, cardHTML, dday } from '../lib/logic.js';
const T = makeT(copy);
const artists = site.artists.filter((a) => a.active);
const banners = site.banners.map((b) => {
  const p = b.dday && products.find((x) => x.id === b.dday);
  return { ...b, src: img('banner', b.img), d: p ? Math.max(dday(p, site.today), 0) : null };
});
---
<Base overlay top>
  <!-- 첫 화면 = 아트: 전면 배너 (PC 화면 가득 / 모바일 1:1), 3.5초 자동 넘김 -->
  <section class="swiper relative aspect-square w-full md:aspect-auto md:h-[min(86vh,760px)] bg-neutral-800 text-white" id="banner">
    <div class="swiper-wrapper">
      {banners.map((b, i) => (
        <a href={b.href} data-click="banner" data-banner={i} class="swiper-slide relative block">
          <div class="ph dark absolute inset-0"><span>{b.img}.jpg</span>{b.src && <img src={b.src} alt="" loading={i ? 'lazy' : 'eager'} />}</div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-transparent to-transparent"></div>
          <div class="wrap absolute inset-x-0 bottom-0 pb-12 md:pb-16">
            <p class="text-xs tracking-[.2em] lowercase text-white/80">{b.label}{b.d !== null && <span class="ml-2 rounded-sm bg-white px-1.5 py-0.5 font-bold tracking-normal text-black" set:html={T('s.dday', { n: b.d })} />}</p>
            <h1 class="mt-2 max-w-3xl text-2xl font-black leading-tight tracking-tight md:text-5xl"><span class="ko" data-bko>{b.title_ko}</span><span class="en" data-ben>{b.title_en}</span></h1>
            <span class="mt-4 inline-block border-b border-white pb-0.5 text-sm font-bold"><span class="ko">{b.cta_ko}</span><span class="en">{b.cta_en}</span> →</span>
          </div>
        </a>
      ))}
    </div>
    <div class="swiper-pagination !bottom-5"></div>
    <button type="button" id="banner-pause" class="absolute bottom-3 right-4 z-10 h-9 w-9 rounded-full bg-black/40 text-sm md:right-8" aria-label="Pause">❚❚</button>
  </section>

  {artists.map((a) => (
    <section class="wrap mt-6 md:mt-10">
      <div class="-mx-4 md:mx-0"><Poster artist={a} /></div>
      <div class="grid-products mt-6" data-grid={a.id} data-limit="4" set:html={sortProducts(products.filter((p) => p.artist === a.id)).slice(0, 4).map((p) => cardHTML(p, null, T, site.today)).join('')} />
      <div class="mt-6 text-center"><a href={`/artist/${a.id}/`} class="btn btn-line !h-11"><Fragment set:html={T('main.more')} /></a></div>
    </section>
  ))}

  <section class="wrap mt-10 md:mt-16">
    <h2 class="text-xl font-black tracking-tight md:text-2xl" set:html={T('main.now')} />
    <div class="mt-4 flex flex-wrap gap-2">
      {site.chips.map((c) => <a href={c.href} class="rounded-full border border-neutral-900 px-4 py-2 text-sm font-bold hover:bg-neutral-900 hover:text-white"><span class="ko">{c.ko}</span><span class="en">{c.en}</span></a>)}
    </div>
  </section>

  <script>
    import Swiper from 'swiper';
    import { Autoplay, Pagination } from 'swiper/modules';
    // 관리자 배너 설정(이 브라우저 저장) 반영: 문구 · 게시 기간 · 사용 여부
    try {
      const st = JSON.parse(localStorage.getItem('kq_demo_v2') || '{}'), bs = st.banner, today = JSON.parse(document.getElementById('__data').textContent).site.today;
      if (bs && st.day === new Date().toLocaleDateString('sv')) document.querySelectorAll('[data-banner]').forEach((el) => {
        const b = bs[el.dataset.banner]; if (!b) return;
        if (!b.on || (b.start && b.start > today) || (b.end && b.end < today)) return el.remove();
        if (b.ko) el.querySelector('[data-bko]').textContent = b.ko;
        if (b.en) el.querySelector('[data-ben]').textContent = b.en;
      });
    } catch {}
    const sw = new Swiper('#banner', { modules: [Autoplay, Pagination], loop: true, autoplay: { delay: 3500, disableOnInteraction: false, pauseOnMouseEnter: true }, pagination: { el: '.swiper-pagination', clickable: true } });
    const btn = document.getElementById('banner-pause');
    let paused = false;
    btn.addEventListener('click', () => { paused = !paused; paused ? sw.autoplay.stop() : sw.autoplay.start(); btn.textContent = paused ? '▶' : '❚❚'; btn.setAttribute('aria-label', paused ? 'Play' : 'Pause'); });
  </script>
</Base>
