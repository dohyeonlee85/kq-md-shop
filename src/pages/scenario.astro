---
import Base from '../layouts/Base.astro';
import { copy, site, img } from '../lib/data.js';
import { makeT } from '../lib/logic.js';
const T = makeT(copy);
---
<Base title="Design Scenarios | KQ MD SHOP" region={false}>
  <div class="wrap mt-8">
    <h1 class="text-3xl font-black tracking-tight md:text-5xl" set:html={T('sc.title')} />
    <p class="mt-3 text-neutral-600" set:html={T('sc.lead')} />
    {site.scenarios.map((s, i) => (
      <section class="mt-14">
        <h2 class="text-xl font-bold md:text-2xl"><span class="mr-2 text-neutral-400">0{i + 1}</span><span class="ko">{s.title_ko}</span><span class="en">{s.title_en}</span></h2>
        <ol class="mt-6 flex snap-x gap-5 overflow-x-auto pb-4">
          {s.steps.map((st, j) => (
            <li class="w-[220px] flex-none snap-start">
              <!-- 같은 폰 프레임 + 번호 원 -->
              <div class="relative rounded-[28px] border-[6px] border-neutral-900 bg-neutral-900">
                <div class="ph aspect-[9/19] rounded-[22px]"><span>scenario/{st.img}.jpg</span>{img('scenario', st.img) && <img src={img('scenario', st.img)} alt="" loading="lazy" />}</div>
                <span class="absolute -left-3 -top-3 flex h-8 w-8 items-center justify-center rounded-full bg-rose-600 text-sm font-bold text-white">{j + 1}</span>
              </div>
              <p class="mt-3 text-[13px] leading-relaxed"><span class="ko">{st.ko}</span><span class="en">{st.en}</span></p>
            </li>
          ))}
        </ol>
      </section>
    ))}
    <div class="mt-12 flex flex-wrap gap-2">
      <a href="/" class="btn btn-ink !h-11">KQ MD SHOP</a>
      <a href="/admin/" class="btn btn-line !h-11" set:html={T('nav.admin')} />
    </div>
  </div>
</Base>
