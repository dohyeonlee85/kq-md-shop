---
import Base from '../../layouts/Base.astro';
import { products, copy, site } from '../../lib/data.js';
import { makeT, badges, buyHTML, price, fmtDate, imgBox } from '../../lib/logic.js';
export function getStaticPaths() {
  return products.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const T = makeT(copy);
const pre = p.sale_type === 'preorder';
const steps = pre ? [['d.t1', p.preorder_start], ['d.t2', p.preorder_end], ['d.t3', p.release], ['d.t4', p.ship_start]] : [];
const done = (d) => d.slice(0, 10) <= site.today;
const endISO = pre ? `${p.preorder_end.replace(' ', 'T')}:00+09:00` : '';
const info = [
  ['d.components', p.components_ko, p.components_en],
  ['d.random', p.random_ko, p.random_en],
  ['d.size', p.size, p.size],
  ['d.material', p.material_ko, p.material_en],
  ['d.origin', p.origin_ko, p.origin_en],
  ['d.tracks', p.tracks_ko, p.tracks_en],
  ['d.release', fmtDate(p.release), fmtDate(p.release)],
  ['d.caution', p.caution_ko, p.caution_en],
].filter((r) => r[1]);
---
<Base title={`${p.name_ko} | KQ MD SHOP`}>
  <div class="wrap md:mt-8 md:grid md:grid-cols-2 md:gap-12" data-detail={p.id}>
    <!-- ① 대표 컷 1장 -->
    <div class="-mx-4 md:mx-0 md:sticky md:top-20 md:self-start" set:html={imgBox(p.img, `${p.id}_main.jpg`, 'aspect-square md:rounded-xl')} />

    <div class="mt-5 md:mt-0">
      <!-- ② 딱지·상품명·공식 표기·가격 -->
      <div class="flex h-5 gap-1" id="badges" set:html={badges(p, null, T)} />
      <h1 class="mt-2 text-xl font-bold leading-snug md:text-2xl"><span class="ko">{p.name_ko}</span><span class="en">{p.name_en}</span></h1>
      <p class="mt-1 text-xs text-neutral-500"><Fragment set:html={T('d.official')} /> · <a class="underline" href="/retailers/" set:html={T('d.retailers')} /></p>
      <p class="mt-3 text-2xl font-black tabular-nums" set:html={price(p)} />

      <!-- ③ 판매 일정: 예약 상품만 4단계, 일반 판매는 1줄 -->
      {pre ? (
        <div class="mt-6 rounded-lg bg-neutral-50 p-4">
          <p class="text-xs font-bold text-neutral-500" set:html={T('d.schedule')} />
          <ol class="mt-3 flex flex-col gap-3 sm:flex-row sm:gap-0">
            {steps.map(([k, d], i) => (
              <li class:list={['relative flex flex-1 gap-3 sm:block sm:pr-2', done(d) ? 'text-neutral-400' : '']}>
                <div class="flex items-center">
                  <span class:list={['h-2.5 w-2.5 flex-none rounded-full', done(d) ? 'bg-neutral-300' : i === 1 ? 'bg-rose-600' : 'bg-neutral-900']}></span>
                  {i < 3 && <span class="hidden h-px flex-1 bg-neutral-300 sm:block"></span>}
                </div>
                <div class="sm:mt-2">
                  <p class:list={['text-xs', i === 1 && !done(d) ? 'font-bold text-rose-600' : '']} set:html={T(k)} />
                  <p class="text-[13px] font-bold tabular-nums">{fmtDate(d)}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="intl mt-3 text-xs text-neutral-600"><Fragment set:html={T('d.local')} />: <b data-localtime={endISO}></b></p>
        </div>
      ) : (
        <p class="mt-6 rounded-lg bg-neutral-50 p-4 text-sm" set:html={T('d.ship', { n: p.ship_days })} />
      )}

      <!-- ④ 옵션·수량·교환 환불·구매 버튼 1개·품질보증 -->
      <div class="mt-6" id="buy" set:html={buyHTML(p, null, T)} />
      <p class="intl mt-4 text-xs text-neutral-600" set:html={T('d.duty')} />
    </div>
  </div>

  <!-- ⑤ 상세 사진 + 상품 정보(글자) -->
  <section class="wrap mt-12 max-w-3xl">
    <div class="space-y-3">
      {p.details.map((d) => <Fragment set:html={imgBox(d.src, d.name, 'aspect-[4/3] rounded-lg')} />)}
    </div>
    <h2 class="mt-10 text-lg font-bold" set:html={T('d.info')} />
    <dl class="mt-3 border-t border-neutral-900 text-sm">
      {info.map(([k, ko, en]) => (
        <div class="grid grid-cols-[104px_1fr] gap-3 border-b border-neutral-200 py-3">
          <dt class="text-neutral-500" set:html={T(k)} />
          <dd><span class="ko">{ko}</span><span class="en">{en}</span></dd>
        </div>
      ))}
      {p.chart ? <div class="grid grid-cols-[104px_1fr] gap-3 border-b border-neutral-200 py-3"><dt class="text-neutral-500" set:html={T('d.chart')} /><dd set:html={T('d.chartv')} /></div> : null}
      <div class="grid grid-cols-[104px_1fr] gap-3 border-b border-neutral-200 py-3"><dt class="text-neutral-500" set:html={T('d.from')} /><dd set:html={T('d.fromv')} /></div>
    </dl>

    <!-- ⑥ 구매 전 안내 -->
    <div class="mt-10">
      <details class="acc" open><summary set:html={T('d.shipping.t')} /><p set:html={T('d.shipping')} /></details>
      <details class="acc"><summary set:html={T('d.cs.t')} /><p set:html={T('d.cs')} /></details>
    </div>
  </section>

  <!-- 스크롤 시 하단 고정 구매 버튼 -->
  <div id="sticky" class="fixed inset-x-0 bottom-0 z-30 translate-y-full border-t border-neutral-200 bg-white p-3 transition-transform">
    <div class="mx-auto flex max-w-3xl items-center gap-3">
      <p class="flex-none text-lg font-black tabular-nums" set:html={price(p)} />
      <div class="flex-1" id="sticky-btn"></div>
    </div>
  </div>
</Base>
