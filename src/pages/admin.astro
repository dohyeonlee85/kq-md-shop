---
// 관리자 데모 (한글 전용 · PC·패드 기준 · 쇼핑몰 헤더·하단 없음)
import Base from '../layouts/Base.astro';
import { orders } from '../lib/data.js';
const menu = [['dash', '① 대시보드'], ['flow', '② 주문 흐름 · 자동화'], ['stock', '③ 상품 · 재고'], ['po', '④ 발주 · 입고']];
---
<Base title="Admin | KQ MD SHOP" bare extra={{ orders }}>
  <div class="min-h-screen bg-neutral-100">
    <p class="bg-neutral-900 px-4 py-2 text-center text-xs text-white">데모 · 매일 초기화</p>
    <div class="wrap py-6 lg:grid lg:grid-cols-[210px_1fr] lg:gap-8">
      <aside class="lg:sticky lg:top-6 lg:self-start">
        <p class="text-xs font-bold tracking-[.2em] text-neutral-500">KQ MD SHOP</p>
        <h1 class="text-2xl font-black">ADMIN</h1>
        <nav class="mt-4 flex gap-4 overflow-x-auto whitespace-nowrap text-sm font-bold lg:flex-col lg:gap-3">
          {menu.map(([id, t]) => <a href={`#${id}`} class="hover:underline">{t}</a>)}
        </nav>
        <div class="mt-5 flex gap-2 lg:flex-col">
          <button type="button" id="a-reset" class="btn btn-line !h-9 !px-3 text-sm">초기화</button>
          <a href="/artist/ateez/" target="_blank" rel="noopener" class="btn btn-ink !h-9 !px-3 text-sm">샵에서 확인</a>
        </div>
        <p class="mt-4 hidden text-xs leading-relaxed text-neutral-500 lg:block">
          <span class="inline-block rounded bg-emerald-100 px-1.5 py-0.5 font-bold text-emerald-800">자동</span> 전산이 처리<br />
          <span class="mt-1 inline-block rounded bg-rose-100 px-1.5 py-0.5 font-bold text-rose-700">승인 필요</span> 사람 판단<br />
          <span class="mt-1 inline-block rounded bg-neutral-200 px-1.5 py-0.5 font-bold text-neutral-700">창고 작업</span> 포장 등 실물
        </p>
      </aside>

      <div class="mt-6 min-w-0 space-y-12 lg:mt-0">
        <section id="dash" class="scroll-mt-6"><h2 class="text-lg font-bold">① 대시보드</h2><div id="a-dash" class="mt-3"></div></section>

        <section id="flow" class="scroll-mt-6">
          <h2 class="text-lg font-bold">② 주문 흐름 · 자동화</h2>
          <div id="a-flow" class="mt-3"></div>
        </section>

        <section id="stock" class="scroll-mt-6">
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="mr-auto text-lg font-bold">③ 상품 · 재고</h2>
            <label class="text-xs text-neutral-600">수정 사유 <select id="a-reason" class="h-9 rounded border border-neutral-300 bg-white px-2"><option>조정</option><option>입고</option><option>불량</option></select></label>
            <button type="button" id="a-down" class="btn btn-line !h-9 !px-3 text-sm">CSV 내려받기</button>
            <label class="btn btn-line !h-9 !px-3 text-sm cursor-pointer">CSV 올리기<input id="a-up" type="file" accept=".csv,text/csv" class="hidden" /></label>
          </div>
          <div id="a-stock" class="mt-3 max-h-[520px] overflow-auto"></div>
          <h3 class="mt-4 font-bold">최근 변경 5건</h3>
          <div class="mt-2 overflow-x-auto"><table class="adm bg-white"><thead><tr><th>일시(KST)</th><th>옵션 코드</th><th>이전 → 새값</th><th>사유</th></tr></thead><tbody id="a-slog"></tbody></table></div>
        </section>

        <section id="po" class="scroll-mt-6"><h2 class="text-lg font-bold">④ 발주 · 입고</h2><div id="a-po" class="mt-3"></div></section>
      </div>
    </div>
  </div>
  <script>import '../lib/admin.js';</script>
</Base>
