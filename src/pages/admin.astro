---
// 관리자 데모 (한글 전용 · PC·패드 기준 · 메뉴별 화면 전환)
import Base from '../layouts/Base.astro';
import { orders, site, img } from '../lib/data.js';
const menu = [['dash', '대시보드'], ['orders', '주문 관리'], ['stock', '상품 · 재고'], ['po', '발주 · 입고'], ['cs', '1:1 문의'], ['banner', '배너'], ['settings', '설정']];
const bannerImg = site.banners.map((b) => img('banner', b.img));
const ctl = 'h-10 rounded border border-neutral-300 bg-white px-2 text-sm';
---
<Base title="Admin | KQ MD SHOP" bare extra={{ orders, bannerImg }}>
  <div class="min-h-screen bg-neutral-100">
    <header class="sticky top-0 z-30 border-b border-neutral-200 bg-white">
      <div class="wrap flex flex-wrap items-center gap-2 py-2">
        <p class="mr-auto font-black">KQ MD SHOP <span class="text-neutral-400">ADMIN</span></p>
        <span class="text-[11px] text-neutral-400">데모 · 매일 초기화</span>
        <span id="a-day" class="rounded bg-neutral-200 px-2 py-1 text-xs font-bold tabular-nums"></span>
        <button type="button" id="a-next" class="btn btn-ink !h-10 !px-3 text-sm">하루 진행 ▶</button>
        <button type="button" id="a-reset" class="btn btn-line !h-10 !px-3 text-sm">초기화</button>
        <a href="/artist/ateez/" target="_blank" rel="noopener" class="btn btn-line !h-10 !px-3 text-sm">샵 보기</a>
      </div>
    </header>
    <div class="wrap py-6 lg:grid lg:grid-cols-[180px_1fr] lg:gap-8">
      <aside class="lg:sticky lg:top-20 lg:self-start">
        <nav class="flex gap-1 overflow-x-auto whitespace-nowrap text-sm font-bold lg:flex-col">
          {menu.map(([id, t]) => <a href={`#${id}`} data-nav={id} class="flex h-10 items-center justify-between gap-2 rounded px-3 hover:bg-white">{t}<span data-badge={id} class="hidden rounded-full bg-rose-600 px-1.5 text-[11px] text-white"></span></a>)}
        </nav>
        <p class="mt-5 hidden text-xs leading-relaxed text-neutral-500 lg:block">
          <span class="inline-block rounded bg-emerald-100 px-1.5 py-0.5 font-bold text-emerald-800">자동</span> 전산 처리<br />
          <span class="mt-1 inline-block rounded bg-rose-100 px-1.5 py-0.5 font-bold text-rose-700">승인 필요</span> 담당자 판단<br />
          <span class="mt-1 inline-block rounded bg-neutral-200 px-1.5 py-0.5 font-bold text-neutral-700">창고 작업</span> 포장 등 실물
        </p>
      </aside>

      <main class="mt-6 min-w-0 lg:mt-0">
        <section data-view="dash"><h2 class="text-lg font-bold">대시보드</h2><div id="a-dash" class="mt-3"></div></section>

        <section data-view="orders" class="hidden">
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="mr-auto text-lg font-bold">주문 관리</h2>
            <button type="button" id="a-pick" class="btn btn-line !h-10 !px-3 text-sm">피킹 리스트 CSV</button>
            <label class="btn btn-line !h-10 !px-3 text-sm cursor-pointer">송장 일괄 입력<input id="a-track" type="file" accept=".csv,text/csv" class="hidden" /></label>
          </div>
          <div id="a-steps" class="mt-3"></div>
          <div id="a-appr" class="mt-4"></div>
          <div class="mt-6 flex flex-wrap items-center gap-2">
            <h3 class="mr-auto font-bold">주문 목록</h3>
            <input id="o-q" type="search" placeholder="주문번호 · 상품명 · 옵션 코드" class={`${ctl} w-60`} />
            <input id="o-from" type="date" class={ctl} /><span class="text-neutral-400">~</span><input id="o-to" type="date" class={ctl} />
          </div>
          <div id="a-olist" class="mt-2"></div>
          <div id="a-log" class="mt-6"></div>
        </section>

        <section data-view="stock" class="hidden">
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="mr-auto text-lg font-bold">상품 · 재고</h2>
            <select id="s-tab" class={ctl}><option value="">전체 카테고리</option></select>
            <button type="button" id="a-new" class="btn btn-ink !h-10 !px-3 text-sm">상품 등록</button>
            <button type="button" id="a-down" class="btn btn-line !h-10 !px-3 text-sm">CSV 내려받기</button>
            <label class="btn btn-line !h-10 !px-3 text-sm cursor-pointer">CSV 올리기<input id="a-up" type="file" accept=".csv,text/csv" class="hidden" /></label>
          </div>
          <div id="a-edit" class="mt-3"></div>
          <div id="a-stock" class="mt-3 max-h-[560px] overflow-auto"></div>
          <div class="mt-6 grid gap-6 xl:grid-cols-2">
            <div><h3 class="font-bold">재고 변경 이력</h3><div class="mt-2 overflow-x-auto"><table class="adm bg-white"><thead><tr><th>일시(KST)</th><th>옵션 코드</th><th>이전 → 새값</th><th>사유</th></tr></thead><tbody id="a-slog"></tbody></table></div></div>
            <div><h3 class="font-bold">상품 정보 변경 이력</h3><div class="mt-2 overflow-x-auto"><table class="adm bg-white"><thead><tr><th>일시(KST)</th><th>상품</th><th>항목</th><th>이전 → 새값</th></tr></thead><tbody id="a-plog"></tbody></table></div></div>
          </div>
        </section>

        <section data-view="po" class="hidden">
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="mr-auto text-lg font-bold">발주 · 입고</h2>
            <button type="button" id="a-podown" class="btn btn-line !h-10 !px-3 text-sm">발주서 CSV</button>
          </div>
          <div id="a-potabs" class="mt-3 flex gap-1 border-b border-neutral-300"></div>
          <div id="a-po" class="mt-4"></div>
        </section>

        <section data-view="cs" class="hidden"><h2 class="text-lg font-bold">1:1 문의</h2><div id="a-cs" class="mt-3"></div></section>

        <section data-view="banner" class="hidden">
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="mr-auto text-lg font-bold">배너</h2>
            <button type="button" id="a-bsave" class="btn btn-ink !h-10 !px-4 text-sm">저장</button>
            <a href="/" target="_blank" rel="noopener" class="btn btn-line !h-10 !px-3 text-sm">메인 보기</a>
          </div>
          <div id="a-banner" class="mt-3 space-y-3"></div>
        </section>

        <section data-view="settings" class="hidden"><h2 class="text-lg font-bold">설정 · 자동화 규칙</h2><div id="a-rules" class="mt-3"></div></section>
      </main>
    </div>
    <button type="button" id="a-top" aria-label="맨 위로" class="pointer-events-none fixed bottom-6 right-6 z-40 flex h-12 w-12 items-center justify-center rounded-full bg-neutral-900 text-lg text-white opacity-0 shadow-lg transition">↑</button>
  </div>
  <script>import '../lib/admin.js';</script>
</Base>
