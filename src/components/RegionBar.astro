---
// 국가·언어·통화 통합 줄 (메인: 배너 아래 / 그 외: 헤더 아래)
import { copy, site } from '../lib/data.js';
import { makeT } from '../lib/logic.js';
const T = makeT(copy);
const intl = T('region.intl').replaceAll('$XX', `$${site.shipping_from_usd}`);
---
<div class="border-b border-neutral-200 bg-neutral-50 text-[13px]">
  <div class="wrap relative flex flex-wrap items-center gap-x-3 gap-y-1 py-2">
    <button type="button" data-open="region" class="flex items-center gap-1.5 text-left">
      <span aria-hidden="true">🌐</span>
      <span><Fragment set:html={T('region.shipto')} /> <b data-country-name></b> · <span data-lang-name></span> · <span data-cur></span></span>
      <span class="underline underline-offset-2 text-neutral-500" set:html={T('region.change')} />
    </button>
    <span class="intl text-neutral-600" set:html={intl} />
    <div id="region" class="dd hidden absolute left-4 md:left-8 top-full z-30 mt-1 w-[min(92vw,420px)] rounded-lg border border-neutral-200 bg-white p-4 shadow-xl">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <p class="mb-2 text-xs text-neutral-500" set:html={T('region.country')} />
          {site.countries.map((c) => (
            <button type="button" data-set-country={c.code} class="block w-full py-1.5 text-left"><span class="ko">{c.ko}</span><span class="en">{c.en}</span></button>
          ))}
        </div>
        <div>
          <p class="mb-2 text-xs text-neutral-500" set:html={T('region.lang')} />
          <button type="button" data-set-lang="ko" class="block w-full py-1.5 text-left">한국어</button>
          <button type="button" data-set-lang="en" class="block w-full py-1.5 text-left">English</button>
          {['日本語', '中文', 'Español'].map((l) => (
            <span class="block py-1.5 text-neutral-400 cursor-default select-none">{l} <Fragment set:html={T('region.demo')} /></span>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
